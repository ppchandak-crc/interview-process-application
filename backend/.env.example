# Database URL (SQLite for testing, change to PostgreSQL/MySQL for heavy production)
DATABASE_URL=sqlite:///./sql_app.db

# Security Configuration
# CRITICAL: Generate a new random secret key for production using: openssl rand -hex 32
SECRET_KEY=YOUR_SUPER_SECRET_KEY_REPLACE_ME_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Project Settings
PROJECT_NAME="Interview Process App"
VERSION="1.0.0"

# CORS Setup - Comma separated list of allowed origins (e.g., https://your-frontend-domain.com)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174", "https://your-production-domain.com"]
